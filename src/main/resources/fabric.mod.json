{
	"schemaVersion": 1,
	"id": "cushion",
	"version": "${version}",
	"name": "Cushion Auto-Interact",
	"description": "当准心对准 cushion 命名空间的实体时，按配置的间隔自动执行使用键（默认右键）交互。支持按键切换开关、JSON 配置。",
	"authors": [
		"cushion"
	],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"cushion.client.CushionClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": ">=26.3-snapshot-3 <26.4",
		"java": ">=25",
		"fabric-api": "*"
	}
}
